# Spotify. Playlists are read from the Web API (see README § Reading playlists),
# which needs an app in EXTENDED QUOTA MODE — a default app 403s on any playlist
# it doesn't own and never sees `popularity`. That is a Spotify review, granted
# to organisations, so most deployments will not have one.
#
# Set these only if your app HAS extended quota mode. It is then the only token
# source used and nothing else below is touched. Leave them blank and the token
# is brokered instead, via the Edge route — see INTERNAL_API_SECRET.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gates /api/internal/spotify-token, the Edge route that fetches the brokered
# Spotify token. Required unless SPOTIFY_CLIENT_ID/SECRET above are set: without
# it that route is disabled and playlists cannot be read at all.
#
# Any long random string, the same value in every environment of one deployment
# (`openssl rand -hex 32`). The route is a private hop between our own Node
# functions and our own Edge runtime, never called by a browser.
INTERNAL_API_SECRET=

# Local development only. The broker is behind a Cloudflare check that refuses
# Node's TLS handshake, and `next dev` emulates the Edge runtime on Node — so
# neither path works locally. Paste a token here to run the real ingest:
#
#   curl -X POST https://www.chosic.com/api/tools/t/ \
#     -A "Mozilla/5.0" -H "app: playlist_analyzer" \
#     -H "Referer: https://www.chosic.com/spotify-playlist-analyzer/" \
#     --data "app=playlist_analyzer"
#
# Tokens last an hour. Never set this in production.
SPOTIFY_TOKEN_OVERRIDE=

# Upstash Redis (REST). https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Replicate. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Signing secret from https://replicate.com/account/webhook (starts with "whsec_").
# If unset, webhooks are accepted on the strength of the per-round key in the
# callback URL alone — fine for local dev, set it in production.
REPLICATE_WEBHOOK_SECRET=

# Public origin used to build the Replicate webhook callback URL.
# Vercel sets VERCEL_URL automatically, which is used as a fallback.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- optional overrides ---
# Demucs model to run. Prediction is created against the model's *latest*
# version, so there is no version hash to keep in sync.
# REPLICATE_DEMUCS_MODEL=ryan5453/demucs
# Rounds per calendar day, across all lobbies. Caps Replicate spend.
# GAMES_PER_DAY=5
# Set to 0 to disable polling Replicate directly while a round is preparing.
# Polling is what makes local dev work without a public webhook URL.
# REPLICATE_POLL_FALLBACK=1
