# Spotify. Playlists are read from the public embed widget with no auth at all
# (see README § Reading playlists). These credentials fetch catalogue metadata
# for track ids we already hold: release year, explicit, duration, album name
# and type — the material the loading-screen jokes are built from.
#
# They do NOT supply popularity any more. Spotify withholds that field from apps
# without extended quota mode, and 403s every ?ids= batch route besides. Par
# comes from Deezer, which needs no credentials at all.
#
# Create an app at https://developer.spotify.com/dashboard — no review, no user
# login, no redirect URI is actually used (put any placeholder if the form asks).
# Leave these blank and the game runs fine, just with blander loading lines.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Upstash Redis (REST). https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Replicate. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Signing secret from https://replicate.com/account/webhook (starts with "whsec_").
# If unset, webhooks are accepted on the strength of the per-round key in the
# callback URL alone — fine for local dev, set it in production.
REPLICATE_WEBHOOK_SECRET=

# Public origin used to build the Replicate webhook callback URL.
# Vercel sets VERCEL_URL automatically, which is used as a fallback.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- optional overrides ---
# Demucs model to run. Prediction is created against the model's *latest*
# version, so there is no version hash to keep in sync.
# REPLICATE_DEMUCS_MODEL=ryan5453/demucs
# Rounds per calendar day, across all lobbies. Caps Replicate spend.
# GAMES_PER_DAY=5
# Set to 0 to disable polling Replicate directly while a round is preparing.
# Polling is what makes local dev work without a public webhook URL.
# REPLICATE_POLL_FALLBACK=1
